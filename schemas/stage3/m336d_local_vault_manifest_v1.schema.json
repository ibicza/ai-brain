{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-brain.local/schemas/stage3/m336d_local_vault_manifest_v1.schema.json",
  "title": "M-33.6d local sealed source vault manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "f19_sha", "acquisition_run_id", "rows", "file_count", "tree_hash", "permission_report_hash", "write_protection_report_hash", "seal_timestamp", "manifest_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "f19_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "acquisition_run_id": {"type": "string", "minLength": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "relative_canonical_path", "role", "byte_size", "sha256", "parent_artifact_identity", "source_use_receipt_hash", "row_hash"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "relative_canonical_path": {"type": "string", "minLength": 1},
          "role": {"enum": ["SOURCE_JAR", "POM", "SCM_ARCHIVE", "JAVA_SOURCE", "LEGAL_DOCUMENT", "QUALIFICATION_WORK"]},
          "byte_size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "parent_artifact_identity": {"type": "string", "minLength": 1},
          "source_use_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "row_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "file_count": {"type": "integer", "minimum": 1},
    "tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "permission_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "write_protection_report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seal_timestamp": {"type": "string", "minLength": 1},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
