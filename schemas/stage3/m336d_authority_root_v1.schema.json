{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-brain.local/schemas/stage3/m336d_authority_root_v1.schema.json",
  "title": "M-33.6d frozen authority root",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_id", "statement_sha256", "statement_size", "policy", "root_hash"],
  "properties": {
    "authority_id": {"const": "M336D_USER_AUTHORITY_V1"},
    "statement_sha256": {"const": "87839e541c1e62ad4311ee20d2a3249271155aca79b8ba0d36b7563d4ce31806"},
    "statement_size": {"const": 382},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "source_use", "publication_allow", "publication_deny", "raw_storage", "authority_may_narrow", "authority_may_widen", "policy_hash"],
      "properties": {
        "policy_id": {"const": "M336D_USER_AUTHORITY_V1"},
        "policy_version": {"const": "m336d.authority.v1"},
        "source_use": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["PRIVATE_LOCAL_ANALYSIS", "LOCAL_RESEARCH_EVALUATION", "DERIVED_KNOWLEDGE_ONLY", "RAW_SOURCE_RETENTION", "PUBLIC_REPRODUCIBLE_EVALUATION"]}
        },
        "publication_allow": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["DERIVED_PACK_PUBLICATION", "METRICS_ONLY_PUBLICATION"]}
        },
        "publication_deny": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["RAW_SOURCE_PUBLICATION", "SOURCE_EXCERPT_PUBLICATION"]}
        },
        "raw_storage": {"const": "LOCAL_SEALED_VAULT_ONLY"},
        "authority_may_narrow": {"const": true},
        "authority_may_widen": {"const": false},
        "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
