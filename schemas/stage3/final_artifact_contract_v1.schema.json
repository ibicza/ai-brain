{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-brain.local/schemas/stage3/final_artifact_contract_v1.schema.json",
  "title": "FinalArtifactContract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_types", "protected_roles", "contract_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactType"}},
    "protected_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "contract_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path_pattern", "role", "media_type", "required_fields", "optional_fields", "forbidden_fields", "field_contracts", "sample_path"],
      "properties": {
        "artifact_type": {"type": "string"},
        "path_pattern": {"type": "string"},
        "role": {"type": "string"},
        "media_type": {"type": "string"},
        "required_fields": {"type": "array"},
        "optional_fields": {"type": "array"},
        "forbidden_fields": {"type": "array"},
        "field_contracts": {"type": "array"},
        "sample_path": {"type": "string"}
      }
    }
  }
}
