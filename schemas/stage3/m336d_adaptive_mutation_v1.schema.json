{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-brain.local/schemas/stage3/m336d_adaptive_mutation_v1.schema.json",
  "title": "M-33.6d adaptive mutation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mutation_count", "category_count", "accepted_count", "wrong_rejection_layer_count", "rows_hash", "category_counts", "rows", "report_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "mutation_count": {"type": "integer", "minimum": 10000},
    "category_count": {"type": "integer", "minimum": 38},
    "accepted_count": {"const": 0},
    "wrong_rejection_layer_count": {"const": 0},
    "rows_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "category_counts": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {"type": "string", "minLength": 1},
          {"type": "integer", "minimum": 1}
        ],
        "items": false
      }
    },
    "rows": {
      "type": "array",
      "minItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mutation_id", "category", "changed_artifact", "dependent_artifacts_regenerated", "forged_tree_hash", "regenerated_receipt_hash", "expected_rejection_layer", "expected_rejection_code", "observed_rejection_layer", "observed_rejection_code", "accepted", "row_hash"],
        "properties": {
          "mutation_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "changed_artifact": {"type": "string", "minLength": 1},
          "dependent_artifacts_regenerated": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "forged_tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "regenerated_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected_rejection_layer": {"enum": ["AUTHORITY", "SCHEMA", "SEMANTIC", "ORDERING"]},
          "expected_rejection_code": {"type": "string", "minLength": 1},
          "observed_rejection_layer": {"enum": ["AUTHORITY", "SCHEMA", "SEMANTIC", "ORDERING"]},
          "observed_rejection_code": {"type": "string", "minLength": 1},
          "accepted": {"const": false},
          "row_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
