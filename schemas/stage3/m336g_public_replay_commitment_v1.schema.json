{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-brain:m336g:public-replay-commitment:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_role",
    "deterministic_production_run_identity",
    "selected_source_manifest_hash",
    "source_entry_binding_manifest_hash",
    "document_manifest_hash",
    "source_count",
    "aggregate_source_closure_manifest_hash",
    "release_identity_hash",
    "parser_artifact_manifest_hash",
    "compiler_semantic_identity_hash",
    "compiler_policy_hash",
    "compiler_report_hash",
    "compilation_trust_gate_hash",
    "evidence_policy_hash",
    "field_evidence_manifest_hash",
    "proposal_manifest_hash",
    "trust_closure_hash",
    "expected_production_artifact_manifest_hash",
    "commitment_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_role": {"const": "PUBLIC_COMMITMENT"},
    "deterministic_production_run_identity": {"type": "string", "minLength": 1},
    "source_count": {"type": "integer", "minimum": 1},
    "selected_source_manifest_hash": {"$ref": "#/$defs/sha256"},
    "source_entry_binding_manifest_hash": {"$ref": "#/$defs/sha256"},
    "document_manifest_hash": {"$ref": "#/$defs/sha256"},
    "aggregate_source_closure_manifest_hash": {"$ref": "#/$defs/sha256"},
    "release_identity_hash": {"$ref": "#/$defs/sha256"},
    "parser_artifact_manifest_hash": {"$ref": "#/$defs/sha256"},
    "compiler_semantic_identity_hash": {"$ref": "#/$defs/sha256"},
    "compiler_policy_hash": {"$ref": "#/$defs/sha256"},
    "compiler_report_hash": {"$ref": "#/$defs/sha256"},
    "compilation_trust_gate_hash": {"$ref": "#/$defs/sha256"},
    "evidence_policy_hash": {"$ref": "#/$defs/sha256"},
    "field_evidence_manifest_hash": {"$ref": "#/$defs/sha256"},
    "proposal_manifest_hash": {"$ref": "#/$defs/sha256"},
    "trust_closure_hash": {"$ref": "#/$defs/sha256"},
    "expected_production_artifact_manifest_hash": {"$ref": "#/$defs/sha256"},
    "commitment_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
