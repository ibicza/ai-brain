{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-brain.local/schemas/stage3/m336d_spdx_expression_scope_v1.schema.json",
  "title": "M-33.6d scoped SPDX evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["expression", "scope", "evidence_receipt_hashes", "status", "reason", "receipt_hash"],
  "properties": {
    "expression": {"type": ["string", "null"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "scope_hash"],
      "properties": {
        "kind": {"enum": ["PROJECT_ROOT", "MODULE_PATH", "SOURCE_PATH_PREFIX", "FILE_OVERRIDE"]},
        "path": {"type": "string", "minLength": 1},
        "scope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence_receipt_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "status": {"enum": ["RESOLVED", "REVIEW_REQUIRED_UNSPECIFIED_MULTI_LICENSE", "REVIEW_REQUIRED_AMBIGUOUS_SCOPE", "TRUE_INCOMPATIBLE_SCOPED_CONFLICT"]},
    "reason": {"type": "string", "minLength": 1},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
