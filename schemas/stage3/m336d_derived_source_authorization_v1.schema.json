{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-brain.local/schemas/stage3/m336d_derived_source_authorization_v1.schema.json",
  "title": "M-33.6d non-widening derived source authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_root_hash", "authority_policy_id", "authority_policy_version", "f19_sha", "acquisition_run_id", "candidate_family_id", "maven_coordinate", "source_repository_url", "source_jar_sha256", "pom_sha256", "immutable_scm_commit", "scm_archive_sha256", "source_tree_hash", "local_vault_manifest_hash", "permitted_source_use_scopes", "permitted_publication_targets", "denied_publication_targets", "parent_receipt_hash", "receipt_hash"],
  "properties": {
    "authority_root_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_policy_id": {"const": "M336D_USER_AUTHORITY_V1"},
    "authority_policy_version": {"const": "m336d.authority.v1"},
    "f19_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "acquisition_run_id": {"type": "string", "minLength": 1},
    "candidate_family_id": {"type": "string", "minLength": 1},
    "maven_coordinate": {"type": "string", "minLength": 1},
    "source_repository_url": {"type": "string", "format": "uri"},
    "source_jar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "immutable_scm_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scm_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local_vault_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "permitted_source_use_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PRIVATE_LOCAL_ANALYSIS", "LOCAL_RESEARCH_EVALUATION", "DERIVED_KNOWLEDGE_ONLY", "RAW_SOURCE_RETENTION", "PUBLIC_REPRODUCIBLE_EVALUATION"]}},
    "permitted_publication_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["DERIVED_PACK_PUBLICATION", "METRICS_ONLY_PUBLICATION"]}},
    "denied_publication_targets": {"const": ["RAW_SOURCE_PUBLICATION", "SOURCE_EXCERPT_PUBLICATION"]},
    "parent_receipt_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
