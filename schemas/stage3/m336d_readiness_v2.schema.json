{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-brain.local/schemas/stage3/m336d_readiness_v2.schema.json",
  "title": "M-33.6d readiness gate V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "primary_receipt_hashes", "criteria", "mandatory_count", "pass_count", "failed_criteria", "decision", "gate_hash"],
  "properties": {
    "schema_version": {"const": 2},
    "mode": {"enum": ["PRE_FREEZE_DISCLOSED", "FINAL_FRESH"]},
    "primary_receipt_hashes": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {"type": "string", "minLength": 1},
          {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        ],
        "items": false
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "primary_report_hashes", "numerator", "denominator", "formula", "observed_result", "threshold", "passed", "criterion_hash"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "primary_report_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "numerator": {"type": "integer", "minimum": 0},
          "denominator": {"type": "integer", "minimum": 1},
          "formula": {"enum": ["EQ", "GE", "RATIO_EQ", "RATIO_GE"]},
          "observed_result": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
          "threshold": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
          "passed": {"type": "boolean"},
          "criterion_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "mandatory_count": {"type": "integer", "minimum": 1},
    "pass_count": {"type": "integer", "minimum": 0},
    "failed_criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decision": {"enum": ["PRE_FREEZE_PASS", "FRESH_JAVA_PROVEN", "FRESH_JAVA_SEMANTICS_PASS_EXPORT_BLOCKED", "BLOCKED"]},
    "gate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
